{
  "name": "ci",
  "stacks": {
    "node": {
      "versions": [
        "20"
      ],
      "packageManager": "pnpm",
      "testCommand": [
        "pnpm",
        "run",
        "ci"
      ],
      "services": {
        "postgres": {
          "version": "16",
          "urlEnv": "TEST_DATABASE_URL",
          "database": "factions"
        }
      }
    }
  },
  "pushBranches": [
    "main"
  ]
}
