{
  "name": "factions",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "test": "turbo run test --concurrency=1",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json",
    "typecheck": "pnpm typecheck:scripts && turbo run typecheck",
    "ci": "pnpm typecheck:scripts && turbo run typecheck test --concurrency=1",
    "db:migrate": "tsx scripts/migrate.ts",
    "rebuild:standings": "tsx scripts/rebuild-standings.ts",
    "rebuild:sessions": "tsx scripts/rebuild-sessions.ts",
    "rebuild:kills": "tsx scripts/rebuild-kills.ts",
    "backfill:achievements": "tsx scripts/backfill-achievements.ts",
    "revoke:achievements": "tsx scripts/revoke-achievements.ts",
    "backfill:achievement-notices": "tsx scripts/backfill-achievement-notices.ts",
    "wipe": "tsx scripts/wipe.ts",
    "launch": "tsx scripts/launch.ts",
    "raid:skip": "tsx scripts/raid-skip.ts",
    "release:sync": "tsx scripts/release-sync.ts",
    "deploy:select": "tsx scripts/deploy-select.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.12",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@factions/db": "workspace:*",
    "@factions/deploy": "workspace:*",
    "@factions/domain": "workspace:*",
    "drizzle-orm": "^0.36.0"
  }
}
