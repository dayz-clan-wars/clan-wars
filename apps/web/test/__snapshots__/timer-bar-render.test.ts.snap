exports[`the timer bar > closed 1`] = `"<div role="region" aria-label="Raid window and server restart" class="border-b-2 border-rule-2 bg-frame"><div class="grid grid-cols-2"><div class="relative flex min-h-[54px] min-w-0 flex-col justify-center gap-[3px] py-2 lg:min-h-[56px] lg:flex-row lg:items-center lg:gap-3.5 pl-4 pr-3 lg:pl-8 lg:pr-5 bg-frame"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] lg:tracking-[0.18em] flex-none text-dim">Raid</span><span aria-hidden="true" class="hidden w-px flex-none self-stretch lg:block bg-rule-2"></span><div class="flex min-w-0 flex-wrap items-baseline gap-x-[7px] gap-y-1 lg:gap-x-2.5"><span class="whitespace-nowrap font-display text-xs uppercase tracking-[0.04em] lg:text-sm text-muted">Starts in</span><span class="whitespace-nowrap font-mono text-[15px] font-bold tabular-nums lg:text-[17px] lg:tracking-[0.02em] text-ink">0m</span></div><div aria-hidden="true" class="absolute inset-x-0 -bottom-0.5 h-0.5"><div class="h-full bg-rule-2" style="width:100.00%"></div></div></div><div class="relative flex min-h-[54px] min-w-0 flex-col justify-center gap-[3px] py-2 lg:min-h-[56px] lg:flex-row lg:items-center lg:gap-3.5 items-end pl-3 pr-4 lg:justify-end lg:pl-5 lg:pr-8 border-l border-rule-2"><span class="font-mono text-[11px] font-bold uppercase tracking-[0.12em] lg:tracking-[0.18em] flex-none text-dim"><span class="lg:hidden">Restart</span><span class="hidden lg:inline">Server restart</span></span><span aria-hidden="true" class="hidden w-px flex-none self-stretch lg:block bg-rule-2"></span><span class="flex-none font-mono text-[15px] font-bold tabular-nums lg:text-[17px] lg:tracking-[0.02em] text-ink">47:12</span><div aria-hidden="true" class="absolute inset-x-0 -bottom-0.5 h-0.5"><div class="ml-auto h-full bg-rule-3" style="width:39.33%"></div></div></div></div></div>"`;

